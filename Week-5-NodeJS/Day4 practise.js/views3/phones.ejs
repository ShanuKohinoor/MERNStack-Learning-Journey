<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phone</title>
        <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    <h1 class= "text-center text-black text-2xl mt-6 mb-6"> Phones</h1>
    <div class=" grid grid-cols-1  sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-10 px-4">
        <% phones.forEach(phone=>{ %>
            <div class=" bg-red-100  flex flex-col items-center rounded-lg">
                <img src="<%=phone.image%>"  alt="<%=phone.name%>" class="object-cover w-48 h-60">
                <h1 class="text-2xl font-bold text-center"><%=phone.name%></h1>
                <p class="text-2xl font-semibold text-center"><%=phone.price%></p>
            </div>

  
       <% }) %>
    </div>


</body>
</html>