<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Baby Products</title>
  <!-- Tailwind CSS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-100 p-6">

  <h1 class="text-3xl font-bold mb-8 text-center">Baby Products</h1>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
    <% products.forEach(product => { %>
      <div class="bg-white rounded-lg shadow p-4 flex flex-col items-center">
        <img src="<%= product.image %>" alt="<%= product.name %>" class="w-40 h-40 object-cover mb-4 rounded" />
        <h2 class="text-xl font-semibold mb-2"><%= product.name %></h2>
        <p class="text-green-600 font-bold"><%= product.price %></p>
      </div>
    <% }) %>
  </div>

</body>
</html>
