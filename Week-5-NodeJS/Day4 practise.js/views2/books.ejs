      <!DOCTYPE html> 
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Famous Malayalam Books</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body >
    <h1 class="text-4xl text-center font-bold mb-8"> Famous Malayalam Books</h1>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <%books.forEach(book =>{%>
        <div class="bg-red-200 rounded-lg shadow flex flex-col items-center">
            <img src="<%=book.coverImage%>" alt="<%=book.name%>" class="w-40 h-45 object-cover">
            <h2 class="text-2xl font-bold"><%= book.name %></h2>
            <p class="text-2xl font-bold text-center"><%=book.author%></p>
            <p class="text-2xl font-bold"><%=book.price%></p>
        </div>
    <%})%>

    </div>
    
</body>
</html>